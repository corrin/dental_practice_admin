<!-- One unattended launcher; business schedules live in the application's local database.
     No encoding declaration: Task Scheduler refuses one here ("unable to switch the encoding"). -->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo><Description>Check application schedules every five minutes.</Description>
    <URI>\Dental Practice Admin\Task runner</URI></RegistrationInfo>
  <Triggers><TimeTrigger><Repetition><Interval>PT5M</Interval><StopAtDurationEnd>false</StopAtDurationEnd></Repetition>
    <StartBoundary>2026-10-03T00:00:00</StartBoundary><Enabled>true</Enabled></TimeTrigger></Triggers>
  <Principals><Principal id="Author"><UserId>practice-app</UserId><LogonType>S4U</LogonType><RunLevel>LeastPrivilege</RunLevel></Principal></Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <StartWhenAvailable>true</StartWhenAvailable><Enabled>true</Enabled>
    <ExecutionTimeLimit>PT30M</ExecutionTimeLimit>
  </Settings>
  <Actions Context="Author"><Exec>
    <Command>C:\Program Files\DentalPracticeAdmin\.venv\Scripts\python.exe</Command>
    <Arguments>-m dental_practice_admin.schedules</Arguments>
    <WorkingDirectory>C:\Program Files\DentalPracticeAdmin</WorkingDirectory>
  </Exec></Actions>
</Task>
