# Caddy, on the server: HTTPS for the admin application on the practice's public address.
#
#   router :80/:443  ->  this server  ->  Caddy (this file)  ->  127.0.0.1:8080, the application
#
# ADMIN_HOST, the public hostname, comes from the server's .env: install_server.ps1 copies it to
# C:\ProgramData\Caddy\caddy.env, which the service passes to Caddy with --envfile. Its DNS A
# record points at the practice's public address.
#
# Other services on the same server and address add their own site files to
# C:\ProgramData\Caddy\sites. Caddy tells sites apart by the Host header and obtains a certificate
# for each, so one port forward serves them all.
#
# Stock Caddy runs this file as written. Nothing here needs a plugin or a custom build.
#
# Access is open to the internet by decision: the Google sign-in allowlist is the gate, so staff
# can work from home without a VPN.

{
	servers {
		trusted_proxies static private_ranges
	}

	# No administration endpoint. It would let any local process rewrite this configuration,
	# for example to serve files from the disk. A changed Caddyfile takes effect on restart.
	admin off
}

# ---------------------------------------------------------------------------
# dental_practice_admin -- patient data, reachable from the internet.
#
# The Google sign-in allowlist is the only access control. Nothing in this file restricts who may
# reach the sign-in page.
# ---------------------------------------------------------------------------
{$ADMIN_HOST} {
	encode zstd gzip

	log {
		output file C:/ProgramData/Caddy/logs/admin-access.log {
			roll_size 10mb
			roll_keep 30
		}
		# Who reached the application and when. With patient data behind this, "was anything
		# accessed" is a question that will eventually be asked.
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# The ChatKit interface is a cross-origin iframe served from OpenAI's CDN, so framing
		# ancestors cannot be set to 'none' without breaking chat.
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	reverse_proxy 127.0.0.1:8080 {
		# Caddy sets X-Forwarded-Proto, X-Forwarded-Host and X-Forwarded-For by default. uvicorn
		# must be started with --proxy-headers to honour them, or every absolute URL the
		# application builds -- including the Google OAuth redirect -- names the internal host
		# and port, and sign-in fails.
		header_up X-Real-IP {remote_host}

		# Chat is served over SSE and a reply can take a while. The default is generous but the
		# intent is worth recording: do not buffer, do not cut the stream short.
		flush_interval -1
		transport http {
			read_timeout 300s
		}
	}
}

# Other services' sites. None is a warning, not an error.
import C:/ProgramData/Caddy/sites/*
