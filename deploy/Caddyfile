# Caddy, on the server, fronting both practice services on one public IP.
#
#                        router :80/:443  ->  server
#                                |
#                           Caddy (this file)
#                                |
#          +---------------------+--------------------------+
#          |                                                |
#   admin.massey-smiles.co.nz                 office.massey-smiles.co.nz
#   -> 127.0.0.1:8080  (this machine)         -> reception:5170  (over the LAN)
#      dental_practice_admin                           SMS_Bridge, /smsgateway/*
#
# Both names are A records pointing at the SAME public IP. Caddy tells them apart by the Host
# header, and obtains a separate certificate for each. That is why one router and one address
# serve two machines without a second port forward.
#
# A subdomain rather than a path for the admin application is deliberate: no path prefix means the
# application needs no URL rewriting, and its session cookie stays scoped to its own host instead
# of being sent to SMS_Bridge on every request.
#
# Stock Caddy runs this file as written. Nothing here needs a plugin or a custom build, so Caddy
# keeps updating itself.
#
# Access is open to the internet by decision: the Google sign-in allowlist is the gate, so staff
# can work from home without a VPN.

{
	# Let's Encrypt registration. A real address, because expiry warnings go here.
	email corrin@morrissheetmetal.co.nz

	servers {
		trusted_proxies static private_ranges
	}

	# No administration endpoint. It would let any local process rewrite this configuration,
	# for example to serve files from the disk. A changed Caddyfile takes effect on restart.
	admin off
}

# ---------------------------------------------------------------------------
# dental_practice_admin -- patient data, reachable from the internet.
#
# The Google sign-in allowlist is the only access control. Nothing in this file restricts who may
# reach the sign-in page.
# ---------------------------------------------------------------------------
admin.massey-smiles.co.nz {
	encode zstd gzip

	log {
		output file C:/ProgramData/Caddy/logs/admin-access.log {
			roll_size 10mb
			roll_keep 30
		}
		# Who reached the application and when. With patient data behind this, "was anything
		# accessed" is a question that will eventually be asked.
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# The ChatKit interface is a cross-origin iframe served from OpenAI's CDN, so framing
		# ancestors cannot be set to 'none' without breaking chat.
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	reverse_proxy 127.0.0.1:8080 {
		# Caddy sets X-Forwarded-Proto, X-Forwarded-Host and X-Forwarded-For by default. uvicorn
		# must be started with --proxy-headers to honour them, or every absolute URL the
		# application builds -- including the Google OAuth redirect -- names the internal host
		# and port, and sign-in fails.
		header_up X-Real-IP {remote_host}

		# Chat is served over SSE and a reply can take a while. The default is generous but the
		# intent is worth recording: do not buffer, do not cut the stream short.
		flush_interval -1
		transport http {
			read_timeout 300s
		}
	}
}

# ---------------------------------------------------------------------------
# SMS_Bridge -- the address Principle's webhook is registered against.
#
# The webhook points at https://office.massey-smiles.co.nz/smsgateway/webhooks/principle. Serving
# the name here keeps that URL and its certificate alive wherever the bridge itself runs, and SMS
# ingress depends on this server being up.
# ---------------------------------------------------------------------------
office.massey-smiles.co.nz {
	encode zstd gzip

	log {
		output file C:/ProgramData/Caddy/logs/office-access.log {
			roll_size 10mb
			roll_keep 30
		}
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# The SMS bridge is dormant, waiting on Principle's API. While its debug routes are on they
	# return patient identifiers to anyone, so nothing reaches it until "Before reactivating SMS"
	# in ACCEPTANCE.md is done; that checklist replaces this line with the bridge's upstream.
	respond "SMS gateway inactive" 503
}
