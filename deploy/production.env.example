# The admin app's settings on the server. scripts\install_server.ps1 copies this to
# C:\Program Files\DentalPracticeAdmin\.env on a first install and stops until every "..." is
# filled in; each upgrade carries that .env forward. Settings in src/dental_practice_admin/config.py
# is the authority on what is required; the README's "Setting up" says where each value comes from.
#
# Keep each comment on its own line: a comment after an empty value becomes the value, so
# `ADMIN_PUBLIC_BASE_URL=   # empty` sets it to "# empty" and Google sign-in fails.

# The public hostname staff open, e.g. admin.your-practice.co.nz. Caddy serves it with HTTPS; the
# Google OAuth client's redirect URI is https://<this>/auth/callback, and the OpenAI platform's
# ChatKit domain allowlist includes it.
ADMIN_HOST=...

# Without these, both would run against staging, with a different database.
PRINCIPLE_ENVIRONMENT=production
ADMIN_DATA_ROOT=C:\ProgramData\DentalPracticeAdmin
PRINCIPLE_API_BASE_URL_PROD=https://api.principle.dental
ADMIN_PLAYWRIGHT_MCP_PATH=node_modules/@playwright/mcp/cli.js
# Empty: each request's own origin, which Caddy forwards.
ADMIN_PUBLIC_BASE_URL=""

ADMIN_SIGN_IN=google
ADMIN_GOOGLE_CLIENT_ID=...
ADMIN_GOOGLE_CLIENT_SECRET=...
# A long random string, new for production.
ADMIN_SESSION_SECRET=...
# Who may sign in: a comma-separated list of Google addresses, a Google Workspace domain, or both;
# "" for the one not used.
ADMIN_STAFF_EMAILS=...
ADMIN_STAFF_DOMAIN=...
ADMIN_CHATKIT_DOMAIN_KEY=...
OPENAI_API_KEY=...
OPENAI_BASE_URL=https://api.openai.com/v1
# A model /v1/models lists for that key.
ADMIN_AGENT_MODEL=...

PRINCIPLE_API_KEY_PROD=...
PRINCIPLE_PRACTICE_ID_PROD=...
# A Principle staff login for browser automation.
PRINCIPLE_UI_EMAIL_PROD=...
PRINCIPLE_UI_PASSWORD_PROD=...
# Principle's own web app settings, the same for every practice (public in app.principle.dental).
PRINCIPLE_FIREBASE_KEY_PROD=AIzaSyAFUaZxaRIaQ6Niptl29ZHuoLuNdW_WPko
PRINCIPLE_FIREBASE_PROJECT_PROD=principle-prod-46b28
PRINCIPLE_FIRESTORE_ROOT_PROD=organisations/.../brands/...
# The workspace exactly as Principle's workspace list shows it, and the segment after
# app.principle.dental/ in its URLs.
PRINCIPLE_WORKSPACE_PROD=...
PRINCIPLE_WORKSPACE_SLUG_PROD=...

AKAHU_APP_TOKEN=...
AKAHU_BASE_URL=https://api.akahu.io/v1
AKAHU_USER_TOKEN=...
# With the Geocoding API enabled.
ADMIN_GOOGLE_MAPS_API_KEY=...
# owner/repository: the practice's private GitHub repository of tasks.
ADMIN_TASK_REPOSITORY=...
# Contents and pull requests on that repository.
ADMIN_GITHUB_TOKEN=...
# The owner's own mobile in international form (+6421...) and email. The recorder's staging
# test patient carries them, so the texts and emails it causes reach the owner.
ADMIN_OWNER_MOBILE=...
ADMIN_OWNER_EMAIL=...
