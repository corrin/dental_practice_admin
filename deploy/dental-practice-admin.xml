<!--
  WinSW service definition. Copy alongside a WinSW release renamed dental-practice-admin.exe, then
  `dental-practice-admin.exe install`.

  %BASE% is the directory holding this file. Runtime data is deliberately NOT under it: a
  release is replaced wholesale during an upgrade, and anything inside would go with it.
-->
<service>
  <id>dental-practice-admin</id>
  <name>Massey Smiles Admin</name>
  <description>Staff pages and run history for the practice, over Principle Dental.</description>

  <executable>%BASE%\.venv\Scripts\python.exe</executable>
  <!-- The proxy-headers option is load-bearing: Caddy terminates TLS, and without it every
       absolute URL this application builds names 127.0.0.1:8080, including the Google OAuth
       redirect. A comment may not contain two hyphens in a row, or WinSW can't read this file. -->
  <arguments>-m uvicorn dental_practice_admin.app:create_app --factory --host 127.0.0.1 --port 8080 --proxy-headers --forwarded-allow-ips 127.0.0.1</arguments>
  <workingdirectory>%BASE%</workingdirectory>

  <!-- Development reload is not part of a service: it watches the filesystem and restarts
       mid-request. Configuration, including PRINCIPLE_ENVIRONMENT and ADMIN_DATA_ROOT, is in the
       release directory's .env, which the scheduled launcher reads too: one place, so the two
       can't run against different Principles or databases. -->

  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="60 sec" />
  <onfailure action="none" />
  <resetfailure>1 hour</resetfailure>

  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>

  <log mode="roll-by-size-time">
    <sizeThreshold>10240</sizeThreshold>
    <pattern>yyyyMMdd</pattern>
    <autoRollAtTime>00:00:00</autoRollAtTime>
    <keepFiles>30</keepFiles>
  </log>
  <logpath>C:\ProgramData\DentalPracticeAdmin\logs</logpath>
</service>
